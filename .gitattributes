# Keep source and generated skill artifacts byte-stable across platforms.
* text=auto

*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mmd text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
LICENSE text eol=lf

# The Bash wrapper has no filename extension.
skills/kanon/scripts/kanon text eol=lf

# Preserve upstream Mermaid bytes; the checksum is recorded in runtime/vendor/VERSION.
runtime/vendor/mermaid.min.js whitespace=-blank-at-eol
