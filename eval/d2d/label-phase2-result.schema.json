{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanon.invalid/eval/d2d/label-phase2-result.schema.json",
  "title": "Kanon D.2D independent label adjudication result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_commitment",
    "unsafe_links_excluded_acknowledged",
    "projection_may_be_incomplete_acknowledged",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "kanon-d2d-label-phase2-result-v1"
    },
    "input_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unsafe_links_excluded_acknowledged": {
      "const": true
    },
    "projection_may_be_incomplete_acknowledged": {
      "const": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/case_result"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "rationale",
        "source_paths"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "rationale": {
          "$ref": "#/$defs/safe_text"
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "decision",
        "rationale",
        "reconciled_selections"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^case-[0-9a-f]{20}$"
        },
        "decision": {
          "enum": [
            "accept-original",
            "accept-new",
            "reconciled",
            "unknown"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/safe_text"
        },
        "reconciled_selections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/selection"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "reconciled"
              }
            }
          },
          "else": {
            "properties": {
              "reconciled_selections": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
