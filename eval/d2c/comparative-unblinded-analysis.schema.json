{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanon.invalid/eval/d2c/comparative-unblinded-analysis.schema.json",
  "title": "Kanon D.2C comparative mechanical unblinding analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bindings",
    "validation",
    "method",
    "counts",
    "matrices",
    "reviewer_agreement",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "kanon-d2c-comparative-unblinded-analysis-v1"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "matrices": {
      "$ref": "#/$defs/matrices"
    },
    "reviewer_agreement": {
      "$ref": "#/$defs/reviewer_agreement"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "origin": {
      "enum": [
        "consensus",
        "prediction-only",
        "label-only"
      ]
    },
    "disputed_origin": {
      "enum": [
        "prediction-only",
        "label-only"
      ]
    },
    "category": {
      "enum": [
        "go-service",
        "monorepo",
        "python-ml",
        "python-web",
        "rust-cli"
      ]
    },
    "prior_disposition": {
      "enum": [
        "clearly-defensible-important",
        "clearly-unsupported",
        "ambiguous-equivalent",
        "insufficient-label-provenance",
        "weak-ranking-signal",
        "unknown"
      ]
    },
    "selection_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "unselected",
        "not_judged_unknown",
        "total"
      ],
      "properties": {
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "unselected": {
          "type": "integer",
          "minimum": 0
        },
        "not_judged_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "origin_selection_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "counts"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "counts": {
          "$ref": "#/$defs/selection_counts"
        }
      }
    },
    "disputed_origin_selection_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "counts"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/disputed_origin"
        },
        "counts": {
          "$ref": "#/$defs/selection_counts"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preparation_commit",
        "predeclaration_commit",
        "restored_artifact_sha256",
        "raw_report_sha256",
        "corpus_manifest_sha256",
        "prior_review_result_sha256",
        "prior_unblinded_analysis_sha256",
        "comparative_preparation_sha256",
        "canonical_input_sha256",
        "reviewer_prompt_sha256",
        "result_schema_sha256",
        "review_cases_sha256",
        "source_case_snapshots_sha256",
        "comparative_case_snapshots_sha256",
        "packet_manifest_sha256",
        "packet_commitment",
        "protocol_sha256",
        "analysis_schema_sha256",
        "result_sha256"
      ],
      "properties": {
        "preparation_commit": {
          "$ref": "#/$defs/commit"
        },
        "predeclaration_commit": {
          "$ref": "#/$defs/commit"
        },
        "restored_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "corpus_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prior_review_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prior_unblinded_analysis_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "comparative_preparation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer_prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_cases_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_case_snapshots_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "comparative_case_snapshots_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packet_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packet_commitment": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "analysis_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "formal_result_valid",
        "schema_version",
        "result_bytes",
        "case_count",
        "unique_case_count",
        "controlled_inputs_unchanged"
      ],
      "properties": {
        "outcome": {
          "const": "pass"
        },
        "formal_result_valid": {
          "const": true
        },
        "schema_version": {
          "const": "kanon-d2c-comparative-result-v1"
        },
        "result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "unique_case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "controlled_inputs_unchanged": {
          "const": true
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_kind",
        "reviewer_unknown_is_negative",
        "unknown_cases_in_set_comparisons",
        "prior_dispositions_modified",
        "reviewer_selections_modified",
        "frozen_labels_modified",
        "official_score_recalculated",
        "release_gate_changed",
        "ground_truth_claimed"
      ],
      "properties": {
        "analysis_kind": {
          "const": "descriptive reviewer agreement"
        },
        "reviewer_unknown_is_negative": {
          "const": false
        },
        "unknown_cases_in_set_comparisons": {
          "const": false
        },
        "prior_dispositions_modified": {
          "const": false
        },
        "reviewer_selections_modified": {
          "const": false
        },
        "frozen_labels_modified": {
          "const": false
        },
        "official_score_recalculated": {
          "const": false
        },
        "release_gate_changed": {
          "const": false
        },
        "ground_truth_claimed": {
          "const": false
        }
      }
    },
    "selection_size_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_size",
        "case_count"
      ],
      "properties": {
        "selection_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "candidate_count",
        "selection_outcomes",
        "unknown_outcomes",
        "selection_size_distribution",
        "selected_candidates",
        "unselected_candidates",
        "not_judged_unknown_candidates"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "selection_outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_outcomes": {
          "type": "integer",
          "minimum": 0
        },
        "selection_size_distribution": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/selection_size_count"
          }
        },
        "selected_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "unselected_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "not_judged_unknown_candidates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "category_origin_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "origins"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/category"
        },
        "origins": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/origin_selection_counts"
          }
        }
      }
    },
    "position_origin_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "count"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "position_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "origins",
        "total"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "origins": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/position_origin_count"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prior_disposition_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_disposition",
        "origins",
        "counts"
      ],
      "properties": {
        "reviewer_disposition": {
          "$ref": "#/$defs/prior_disposition"
        },
        "origins": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/disputed_origin_selection_counts"
          }
        },
        "counts": {
          "$ref": "#/$defs/selection_counts"
        }
      }
    },
    "matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_selection",
        "category_origin_selection",
        "selected_position_by_origin",
        "prior_disposition_selection"
      ],
      "properties": {
        "origin_selection": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/origin_selection_counts"
          }
        },
        "category_origin_selection": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/category_origin_matrix"
          }
        },
        "selected_position_by_origin": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/position_matrix"
          }
        },
        "prior_disposition_selection": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/prior_disposition_matrix"
          }
        }
      }
    },
    "path_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_path_count",
        "reference_path_count",
        "intersection_path_count",
        "union_path_count",
        "symmetric_difference_path_count",
        "jaccard_numerator",
        "jaccard_denominator",
        "jaccard_reviewer_agreement"
      ],
      "properties": {
        "reviewer_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "reference_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "intersection_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "union_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "symmetric_difference_path_count": {
          "type": "integer",
          "minimum": 0
        },
        "jaccard_numerator": {
          "type": "integer",
          "minimum": 0
        },
        "jaccard_denominator": {
          "type": "integer",
          "minimum": 0
        },
        "jaccard_reviewer_agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "closer_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_closer",
        "label_closer",
        "tie",
        "unknown_not_compared",
        "total"
      ],
      "properties": {
        "prediction_closer": {
          "type": "integer",
          "minimum": 0
        },
        "label_closer": {
          "type": "integer",
          "minimum": 0
        },
        "tie": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_not_compared": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exact_match_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction",
        "label",
        "both",
        "unknown_not_compared"
      ],
      "properties": {
        "prediction": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "integer",
          "minimum": 0
        },
        "both": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_not_compared": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewer_agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_case_count",
        "unknown_case_count_excluded",
        "with_predictions",
        "with_labels",
        "closer_case_counts",
        "exact_set_matches"
      ],
      "properties": {
        "selection_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_case_count_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "with_predictions": {
          "$ref": "#/$defs/path_agreement"
        },
        "with_labels": {
          "$ref": "#/$defs/path_agreement"
        },
        "closer_case_counts": {
          "$ref": "#/$defs/closer_counts"
        },
        "exact_set_matches": {
          "$ref": "#/$defs/exact_match_counts"
        }
      }
    },
    "nullable_integer": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullable_boolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "set_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_selection_size",
        "prediction_intersection_size",
        "label_intersection_size",
        "prediction_symmetric_difference_distance",
        "label_symmetric_difference_distance",
        "closer",
        "exact_prediction_set_match",
        "exact_label_set_match"
      ],
      "properties": {
        "reviewer_selection_size": {
          "$ref": "#/$defs/nullable_integer"
        },
        "prediction_intersection_size": {
          "$ref": "#/$defs/nullable_integer"
        },
        "label_intersection_size": {
          "$ref": "#/$defs/nullable_integer"
        },
        "prediction_symmetric_difference_distance": {
          "$ref": "#/$defs/nullable_integer"
        },
        "label_symmetric_difference_distance": {
          "$ref": "#/$defs/nullable_integer"
        },
        "closer": {
          "enum": [
            "prediction-closer",
            "label-closer",
            "tie",
            "unknown-not-compared"
          ]
        },
        "exact_prediction_set_match": {
          "$ref": "#/$defs/nullable_boolean"
        },
        "exact_label_set_match": {
          "$ref": "#/$defs/nullable_boolean"
        }
      }
    },
    "file_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "sha256"
      ],
      "properties": {
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "prior_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_status",
        "item_id",
        "case_id",
        "origin",
        "category",
        "reviewer_disposition",
        "rationale",
        "direct_sources",
        "reviewed_file_metadata",
        "packet_commitment",
        "review_result_sha256"
      ],
      "properties": {
        "join_status": {
          "enum": [
            "joined-disputed",
            "not-applicable-consensus"
          ]
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^item-[0-9a-f]{24}$"
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^case-[0-9a-f]{20}$"
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/disputed_origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "oneOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer_disposition": {
          "oneOf": [
            {
              "$ref": "#/$defs/prior_disposition"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "oneOf": [
            {
              "$ref": "#/$defs/bounded_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "direct_sources": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "reviewed_file_metadata": {
          "oneOf": [
            {
              "$ref": "#/$defs/file_metadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "packet_commitment": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_result_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "path",
        "file_metadata",
        "origin",
        "prediction_member",
        "label_member",
        "consensus",
        "review_status",
        "selected_position",
        "comparative_rationale",
        "comparative_direct_sources",
        "prior_d2c"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9a-f]{24}$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "file_metadata": {
          "$ref": "#/$defs/file_metadata"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "prediction_member": {
          "type": "boolean"
        },
        "label_member": {
          "type": "boolean"
        },
        "consensus": {
          "type": "boolean"
        },
        "review_status": {
          "enum": [
            "selected",
            "unselected",
            "not-judged-unknown"
          ]
        },
        "selected_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "comparative_rationale": {
          "oneOf": [
            {
              "$ref": "#/$defs/bounded_text"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparative_direct_sources": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "prior_d2c": {
          "$ref": "#/$defs/prior_join"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "d2a_case_id",
        "repository",
        "revision",
        "category",
        "outcome",
        "unknown_reason",
        "unknown_not_negative",
        "frozen_prediction_paths",
        "frozen_label_paths",
        "reviewer_selected_paths",
        "set_comparison",
        "candidates"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^case-[0-9a-f]{20}$"
        },
        "d2a_case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "revision": {
          "$ref": "#/$defs/commit"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "outcome": {
          "enum": [
            "selection",
            "unknown"
          ]
        },
        "unknown_reason": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]*$"
        },
        "unknown_not_negative": {
          "type": "boolean"
        },
        "frozen_prediction_paths": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "frozen_label_paths": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "reviewer_selected_paths": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "set_comparison": {
          "$ref": "#/$defs/set_comparison"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    }
  }
}
