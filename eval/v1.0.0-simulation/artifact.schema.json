{
  "$id": "https://kanon.invalid/schema/v1.0.0-simulation-artifact-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "evidence_classification": "simulated-development-only",
  "human_independence": false,
  "prospective_protocol_activated": false,
  "release_authority": false,
  "simulation": true,
  "$defs": {
    "hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "minLength": 1,
      "type": "string"
    },
    "bindings": {
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      },
      "minProperties": 4,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*_sha256$"
      },
      "type": "object"
    },
    "evidence_classification": {
      "const": "simulated-development-only"
    },
    "human_independence": {
      "const": false
    },
    "payload": {
      "type": "object"
    },
    "producer": {
      "enum": [
        "SIM-CO",
        "SIM-CE",
        "SIM-LA",
        "SIM-LB",
        "SIM-ADJ",
        "SIM-RO"
      ]
    },
    "prospective_protocol_activated": {
      "const": false
    },
    "release_authority": {
      "const": false
    },
    "schema": {
      "const": "kanon-v1.0.0-simulation-artifact-v1"
    },
    "sequence": {
      "maximum": 18,
      "minimum": 1,
      "type": "integer"
    },
    "simulated_status": {
      "const": "simulated"
    },
    "simulation": {
      "const": true
    }
  },
  "required": [
    "artifact_type",
    "bindings",
    "evidence_classification",
    "human_independence",
    "payload",
    "producer",
    "prospective_protocol_activated",
    "release_authority",
    "schema",
    "sequence",
    "simulated_status",
    "simulation"
  ],
  "title": "Kanon v1.0.0 simulation artifact envelope",
  "type": "object"
}
