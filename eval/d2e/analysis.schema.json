{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanon.invalid/schemas/d2e-analysis-v1.json",
  "title": "Kanon D.2E trace-to-decision conclusion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bindings",
    "disposition",
    "counts",
    "support",
    "controls",
    "counterexamples",
    "preferred_hypothesis",
    "next_correction_boundary",
    "effects",
    "governance",
    "limitations",
    "correction_implemented"
  ],
  "properties": {
    "schema_version": {
      "const": "kanon-d2e-analysis-v1"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "disposition": {
      "enum": [
        "supported-generic-hypothesis",
        "no-supported-generic-hypothesis"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "candidates",
        "eligible_candidates",
        "support_candidates",
        "support_cases",
        "support_categories",
        "control_candidates",
        "control_cases",
        "control_categories",
        "counterexamples",
        "incomplete_scans"
      ],
      "properties": {
        "cases": {
          "const": 30
        },
        "candidates": {
          "$ref": "#/$defs/count"
        },
        "eligible_candidates": {
          "$ref": "#/$defs/count"
        },
        "support_candidates": {
          "$ref": "#/$defs/count"
        },
        "support_cases": {
          "$ref": "#/$defs/count"
        },
        "support_categories": {
          "$ref": "#/$defs/count"
        },
        "control_candidates": {
          "$ref": "#/$defs/count"
        },
        "control_cases": {
          "$ref": "#/$defs/count"
        },
        "control_categories": {
          "$ref": "#/$defs/count"
        },
        "counterexamples": {
          "$ref": "#/$defs/count"
        },
        "incomplete_scans": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "support": {
      "$ref": "#/$defs/evidenceList"
    },
    "controls": {
      "$ref": "#/$defs/evidenceList"
    },
    "counterexamples": {
      "$ref": "#/$defs/evidenceList"
    },
    "preferred_hypothesis": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/hypothesis"
        }
      ]
    },
    "next_correction_boundary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/text"
        }
      ]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision_direction",
        "false_positive_range",
        "recall_direction",
        "true_positive_displacement_range",
        "added_false_negative_range",
        "displacement_risk"
      ],
      "properties": {
        "precision_direction": {
          "$ref": "#/$defs/text"
        },
        "false_positive_range": {
          "$ref": "#/$defs/range"
        },
        "recall_direction": {
          "$ref": "#/$defs/text"
        },
        "true_positive_displacement_range": {
          "$ref": "#/$defs/range"
        },
        "added_false_negative_range": {
          "$ref": "#/$defs/range"
        },
        "displacement_risk": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_aware",
        "independent_evidence",
        "human_label_governance",
        "next_action"
      ],
      "properties": {
        "outcome_aware": {
          "const": true
        },
        "independent_evidence": {
          "const": false
        },
        "human_label_governance": {
          "const": "separate-and-blocked"
        },
        "next_action": {
          "enum": [
            "one-bounded-correction-cycle",
            "honest-prerelease-or-governance-wait"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "correction_implemented": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "supported-generic-hypothesis"
          }
        }
      },
      "then": {
        "properties": {
          "counts": {
            "type": "object",
            "properties": {
              "support_cases": {
                "minimum": 3
              },
              "support_categories": {
                "minimum": 2
              },
              "control_cases": {
                "minimum": 3
              },
              "control_categories": {
                "minimum": 2
              },
              "counterexamples": {
                "minimum": 1
              }
            }
          },
          "preferred_hypothesis": {
            "$ref": "#/$defs/hypothesis"
          },
          "next_correction_boundary": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "preferred_hypothesis": {
            "type": "null"
          },
          "next_correction_boundary": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 750000
    },
    "range": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/count"
        },
        {
          "$ref": "#/$defs/count"
        }
      ],
      "items": false
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "protocol_sha256",
        "trace_schema_sha256",
        "analysis_schema_sha256",
        "corpus_sha256",
        "d2a_report_sha256",
        "cache_identity_sha256",
        "artifact_sha256",
        "conformance_report_sha256",
        "attempt_binding_sha256",
        "raw_report_sha256",
        "trace_set_sha256",
        "equivalence_sha256",
        "mechanism_analysis_sha256"
      ],
      "properties": {
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trace_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "analysis_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "corpus_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "d2a_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cache_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "conformance_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attempt_binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trace_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "equivalence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mechanism_analysis_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceList": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "category",
        "candidate_id",
        "path",
        "status",
        "scan_complete",
        "comparative_status"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/text"
        },
        "category": {
          "$ref": "#/$defs/text"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^candidate-[0-9a-f]{64}$"
        },
        "path": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "selected-true-positive",
            "selected-false-positive",
            "unselected-false-negative",
            "unselected-control"
          ]
        },
        "scan_complete": {
          "type": "boolean"
        },
        "comparative_status": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "production_mechanism",
        "claim",
        "small_correction",
        "falsification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "production_mechanism": {
          "$ref": "#/$defs/text"
        },
        "claim": {
          "$ref": "#/$defs/text"
        },
        "small_correction": {
          "$ref": "#/$defs/text"
        },
        "falsification": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
