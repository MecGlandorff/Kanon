#!/usr/bin/env bash
set -euo pipefail

COMMAND="todo"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_KANON="$SCRIPT_DIR/../../../bin/kanon.js"

if [[ -x "$LOCAL_KANON" ]]; then
  if ! command -v node >/dev/null 2>&1; then
    echo "Kanon requires Node.js 20+ to run the local package CLI." >&2
    exit 127
  fi
  exec node "$LOCAL_KANON" "$COMMAND" "$@"
fi

echo "Kanon skill runtime is incomplete: expected $LOCAL_KANON." >&2
echo "Install the full Kanon skill package in Codex or Claude Code; these wrappers are not a standalone terminal interface." >&2
exit 127
