{
  "description": "Disposable Guard feasibility hooks for Codex CLI.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/probe-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "Recording Kanon Guard spike session event"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/probe-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking Kanon Guard spike Bash call"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/probe-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking Kanon Guard spike patch call"
          }
        ]
      }
    ]
  }
}
